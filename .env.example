# Chain
SUBTENSOR_NETWORK=test
SUBTENSOR_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443
NETUID=467

# Wallets (names under ~/.bittensor/wallets)
BT_WALLET_COLD=default
BT_WALLET_HOT=default

# Miner axon (validators must reach IP:AXON_PORT)
AXON_PORT=8091
# AXON_EXTERNAL_IP=
# AXON_DISCOVER_EXTERNAL_IP=false

# Problem seed (quantize = N-block windows; subnet_epoch = follow chain Tempo)
LEMMA_PROBLEM_SEED_MODE=quantize
LEMMA_PROBLEM_SEED_QUANTIZE_BLOCKS=100
# LEMMA_PROBLEM_SEED_CHAIN_HEAD_SLACK_BLOCKS=0

# Lean verify (validator only)
LEMMA_USE_DOCKER=true
# LEMMA_LEAN_DOCKER_WORKER=lemma-lean-worker
# LEMMA_LEAN_DOCKER_WORKER_HOST_ROOT=/var/lib/lemma-lean-cache
# LEMMA_LEAN_DOCKER_WORKER_MOUNT=/lemma-workspace
LEAN_VERIFY_TIMEOUT_S=300
# LEMMA_LEAN_VERIFY_MAX_CONCURRENT=4
# LEMMA_LEAN_VERIFY_WORKSPACE_CACHE_DIR=/var/lib/lemma-lean-cache
# LEMMA_LEAN_WORKSPACE_CACHE_MAX_DIRS=8
# LEMMA_LEAN_WORKSPACE_CACHE_MAX_BYTES=17179869184
# LEMMA_LEAN_WORKSPACE_CACHE_INCLUDE_SUBMISSION_HASH=false
# LEMMA_LEAN_NUM_THREADS=16
# LEMMA_LEAN_VERIFY_FULL_BUILD=false
# LEMMA_LEAN_ALWAYS_CACHE_GET=false

# Validator timing / supply
# LEMMA_BLOCK_TIME_SEC_ESTIMATE=12
# LEMMA_FORWARD_WAIT_MAX_S=240
# LEMMA_EPOCH_PROBLEM_COUNT=1
# LEMMA_REPUTATION_STATE_PATH=
# LEMMA_MATHLIB_ROOT_PATH=
# LEMMA_COMPETITION_FORMAL_PATH=
# LEMMA_SUPPLY_FRESHNESS_PATH=
# LEMMA_SUPPLY_FALLBACK_GENERATED=false
# LEMMA_SUPPLY_PUBLIC_CORPUS_BLOOM_PATH=

# HTTP body cap (signed Epistula)
# LEMMA_INBOUND_MAX_CHARS=500000

# Process env overrides .env when set (otherwise .env wins)
# LEMMA_PREFER_PROCESS_ENV=false

LOG_LEVEL=INFO
