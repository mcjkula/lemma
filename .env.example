# Chain — Lemma currently runs on Bittensor testnet (NETUID 467).
SUBTENSOR_NETWORK=test
SUBTENSOR_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443
NETUID=467

# Future Finney (mainnet) — hand-edit when Lemma has a mainnet netuid.
# SUBTENSOR_NETWORK=finney
# SUBTENSOR_CHAIN_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
# NETUID=

# Wallets (names under ~/.bittensor/wallets)
BT_WALLET_COLD=default
BT_WALLET_HOT=default

# Miner axon (validators must reach IP:AXON_PORT)
AXON_PORT=8091
# Set explicitly for production miners. Public-IP discovery is opt-in because it calls third-party HTTPS services.
# For local-only testing set AXON_EXTERNAL_IP=127.0.0.1
# AXON_EXTERNAL_IP=
# AXON_DISCOVER_EXTERNAL_IP=false

# Problem seed: quantize = N-block windows (default), subnet_epoch = follow chain Tempo.
LEMMA_PROBLEM_SEED_MODE=quantize
LEMMA_PROBLEM_SEED_QUANTIZE_BLOCKS=100
# Optional: subtract blocks from RPC head before seed (align validators across endpoints).
# LEMMA_PROBLEM_SEED_CHAIN_HEAD_SLACK_BLOCKS=0

# Lean verify (validator only) — `lemma validator` requires LEMMA_USE_DOCKER=true.
LEMMA_USE_DOCKER=true
# Long-lived worker container for `docker exec` verify (mandatory; one-shot `docker run` is not supported).
# LEMMA_LEAN_DOCKER_WORKER=lemma-lean-worker
# LEMMA_LEAN_DOCKER_WORKER_HOST_ROOT=/var/lib/lemma-lean-cache
# LEMMA_LEAN_DOCKER_WORKER_MOUNT=/lemma-workspace
# Per-submission lake build budget (seconds). Raise if Mathlib builds time out on cold cache.
LEAN_VERIFY_TIMEOUT_S=300
# LEMMA_LEAN_VERIFY_MAX_CONCURRENT=4
# Warm `.lake` per theorem template (fast after first passing verify for that template).
# LEMMA_LEAN_VERIFY_WORKSPACE_CACHE_DIR=/var/lib/lemma-lean-cache
# Bound warm cache slots so problem variety cannot fill the disk.
# LEMMA_LEAN_WORKSPACE_CACHE_MAX_DIRS=8
# Bound total warm cache bytes. Default 16 GiB; set 0 to disable byte pruning.
# LEMMA_LEAN_WORKSPACE_CACHE_MAX_BYTES=17179869184
# Rare: isolate cache slots per proof body (more disk). Default: template-only key.
# LEMMA_LEAN_WORKSPACE_CACHE_INCLUDE_SUBMISSION_HASH=false
# Lean thread pool (Lake / elaboration); default = logical cores (cap 64).
# LEMMA_LEAN_NUM_THREADS=16
# Full `lake build` (default: Submission only).
# LEMMA_LEAN_VERIFY_FULL_BUILD=false
# Force `lake exe cache get` even when `.lake/packages/mathlib` exists (default skips warm workspaces).
# LEMMA_LEAN_ALWAYS_CACHE_GET=false

# Validator timing
# Block-time estimate; used to clamp the miner-answer wait below.
# LEMMA_BLOCK_TIME_SEC_ESTIMATE=12
# Clamp on how long the validator waits for one miner answer (until the next seed edge).
# LEMMA_FORWARD_WAIT_MAX_S=240
# LEMMA_EPOCH_PROBLEM_COUNT=1
# LEMMA_REPUTATION_STATE_PATH=

# Problem supply seed corpora (optional; defaults to bundled generated seeds)
# LEMMA_MATHLIB_ROOT_PATH=
# LEMMA_COMPETITION_FORMAL_PATH=
# LEMMA_SUPPLY_FRESHNESS_PATH=
# LEMMA_SUPPLY_FALLBACK_GENERATED=false
# LEMMA_SUPPLY_PUBLIC_CORPUS_BLOOM_PATH=

# HTTP body cap (signed Epistula)
# LEMMA_INBOUND_MAX_CHARS=500000

# Pydantic source order: set to 1 to make process env override .env (CI / Docker-only env).
# LEMMA_PREFER_PROCESS_ENV=false

LOG_LEVEL=INFO
